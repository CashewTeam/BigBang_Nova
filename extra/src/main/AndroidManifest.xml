<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="com.cashewteam.novatext.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="Nova Text Extra"
        android:theme="@style/Theme.NovaTextExtra">
        <activity
            android:name=".ExtraActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="false" />

        <receiver
            android:name=".TriggerDiagnosticReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cashewteam.novatext.extra.TRIGGERED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
